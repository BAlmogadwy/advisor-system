exclude_dirs:
  - tests
  - .venv
  - venv
  - migrations
  - .claude
  - import_old
  - csv_export
  - tmp
  # Isolated review/replay source copies (gitignored). Each carries its own
  # .bandit, and recursive discovery finding several of them stopped the hook.
  - .tmp
  # Gitignored build/vendor artifacts — not project source. Scanning them made
  # the pre-commit hook fail on third-party Python vendored inside node_modules
  # (e.g. outputs/xlsx_build/node_modules/.../node-gyp/gyp/pylib).
  - node_modules
  - outputs
  - runtime
skips:
  - B101
  - B105
  - B106
  - B110
  - B311
  - B404
  - B603
  - B607
