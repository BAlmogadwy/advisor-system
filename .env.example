# ── Django Core ──────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-generate-a-real-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ─────────────────────────────────────────────────
# Uncomment for PostgreSQL (required in production):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ── CSRF (required in production for HTTPS) ──────────────────
# CSRF_TRUSTED_ORIGINS=https://yourdomain.onrender.com

# ── Portal Scraper Credentials (local dev only) ─────────────
PORTAL_ADMIN_USERNAME=
PORTAL_ADMIN_PASSWORD=

# ── Optional / Dev-Only ──────────────────────────────────────
# ALLOW_DEV_ROLE_SWITCH=true
# ADVISOR_DB_PATH=path/to/legacy/advisor.db

# Optional Neo4j Timetable Graph Twin
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change-me
# NEO4J_DATABASE=neo4j

# WhatsApp Advisor Gateway
# WHATSAPP_VERIFY_TOKEN=change-me-long-random-string
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_STUDENT_EMAIL_DOMAIN=
# WHATSAPP_OTP_TTL_SECONDS=300
# WHATSAPP_OTP_MAX_ATTEMPTS=5
# WHATSAPP_ALLOW_SUPER_ADMIN=false
# DEFAULT_FROM_EMAIL=advisor-bot@your-university.edu

# ── LLM backend ──────────────────────────────────────────────────
# Which endpoint the virtual adviser speaks to. Returning to the local server is
# this one line and a restart — no code change, no branch change.
#   local   = the LOCAL_LLM_* server above (LM Studio &c.)
#   alibaba = Alibaba Cloud Model Studio, OpenAI-compatible endpoint
# An unknown value refuses to start rather than guessing.
LLM_BACKEND=local

# Alibaba Cloud Model Studio. All three of URL, key and model are REQUIRED before
# LLM_BACKEND=alibaba will start; the model is never discovered from the
# workspace, because a silent choice of model is a silent choice of price.
#
# Base URL — the WORKSPACE endpoint from your own Model Studio console. The
# validator accepts only this exact shape, so the public DashScope hosts this
# file used to recommend will not start:
#   https://<workspace>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# https only, no port, no query, no userinfo, and only the compatible-mode path.
ALIBABA_LLM_BASE_URL=

# NEVER put a real key in this file. THIS FILE IS TRACKED IN GIT — it is
# `.env.example`, not `.env`. Copy it to an untracked `.env`, or set the key in
# the deployment secret manager, and leave this line empty.
ALIBABA_LLM_API_KEY=

# Exact model id as the console shows it, e.g. qwen3.7-max. If the workspace and
# region do not expose the model you want, stop — nothing here substitutes one.
ALIBABA_LLM_MODEL=

# Non-thinking for the first provider comparison: the local model has already
# spent whole tool turns on hidden reasoning, and changing reasoning mode at the
# same time as the provider measures neither.
ALIBABA_LLM_ENABLE_THINKING=false
ALIBABA_LLM_TIMEOUT_SECONDS=75
ALIBABA_LLM_MAX_TOKENS=3000
ALIBABA_LLM_MAX_RETRIES=2

# THE EGRESS KILL SWITCH. The transport refuses every outbound Alibaba request
# unless this is explicitly true — whatever LLM_BACKEND says, and whichever code
# path built the client. Keep it false except during an explicitly approved live
# operation, and set it back afterwards.
ALIBABA_LLM_ALLOW_LIVE_REQUESTS=false

# The evaluation JUDGE stays local on purpose. Judging Alibaba-generated answers
# with Alibaba is a provider marking its own homework.
EVAL_JUDGE_LLM_BACKEND=local

# Student Advisor V2 is one read-only academic agent. It can prepare and explain
# course proposals, but it cannot register courses, save/apply a timetable, or
# change the university portal. Keep off until the V2 evaluation is accepted.
STUDENT_ADVISOR_V2_ENABLED=false
STUDENT_ADVISOR_V2_MAX_TOOL_ITERATIONS=4
STUDENT_ADVISOR_V2_MAX_TOOL_CALLS=8
STUDENT_ADVISOR_V2_MAX_TOKENS=1800
STUDENT_ADVISOR_V2_TOOL_TIMEOUT_SECONDS=75
