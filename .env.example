# ── Django Core ──────────────────────────────────────────────
DJANGO_SECRET_KEY=change-me-generate-a-real-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# ── Database ─────────────────────────────────────────────────
# Uncomment for PostgreSQL (required in production):
# DATABASE_URL=postgres://user:password@host:5432/dbname

# ── CSRF (required in production for HTTPS) ──────────────────
# CSRF_TRUSTED_ORIGINS=https://yourdomain.onrender.com

# ── Portal Scraper Sign-In ──────────────────────────────────
# You sign in yourself, once:  manage.py portal_login
# The session is saved to .portal_session.json and reused. NOTHING below is
# needed for that, and PORTAL_ADMIN_PASSWORD should be left empty.
# PORTAL_SESSION_STATE_PATH=/absolute/path/to/.portal_session.json
# PORTAL_LOGIN_URL=https://eas.taibahu.edu.sa/TaibahReg/staffLogin.do?ex=preLogin
#
# ONLY for an account the university has approved for unattended use. For a human
# staff account leave this off: an unattended sign-in cannot answer MFA, consent
# or Conditional Access, and every automated mis-step counts toward lockout.
# PORTAL_UNATTENDED_LOGIN=false
# PORTAL_ADMIN_USERNAME=          # full UPN, e.g. user@taibahu.edu.sa
# PORTAL_ADMIN_PASSWORD=
# PORTAL_SSO_TIMEOUT_MS=120000

# ── Optional / Dev-Only ──────────────────────────────────────
# ALLOW_DEV_ROLE_SWITCH=true
# ADVISOR_DB_PATH=path/to/legacy/advisor.db
# Optional Neo4j Timetable Graph Twin
# NEO4J_URI=bolt://localhost:7687
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=change-me
# NEO4J_DATABASE=neo4j

# WhatsApp Advisor Gateway
# WHATSAPP_VERIFY_TOKEN=change-me-long-random-string
# WHATSAPP_APP_SECRET=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_OTP_TTL_SECONDS=300
# WHATSAPP_OTP_MAX_ATTEMPTS=5
# WHATSAPP_ALLOW_SUPER_ADMIN=false

# Telegram Advisor Gateway — a TRANSPORT for the existing Student Advisor.
# Off by default. See docs/TELEGRAM-ADVISOR-CHANNEL.md.
#
# Every one of these is a credential or a switch. Two of them fail CLOSED when
# unset, deliberately: with no TELEGRAM_WEBHOOK_SECRET the webhook refuses every
# call (there is no DEBUG relaxation), and with no TELEGRAM_BOT_TOKEN the client
# never opens a socket.
# TELEGRAM_ADVISOR_ENABLED=false
# TELEGRAM_BOT_TOKEN=
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Must equal the `secret_token` passed to setWebhook, exactly.
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_BOT_USERNAME=
# The https:// origin the linking URL is built from. Without it /link refuses
# rather than sending a token that points nowhere.
# TELEGRAM_PUBLIC_BASE_URL=
# TELEGRAM_LINK_TOKEN_TTL_SECONDS=900
# Maximum age of the OTP-authenticated browser session allowed to approve a link.
TELEGRAM_LINK_AUTH_MAX_AGE_SECONDS=600
TELEGRAM_MAX_PENDING_PER_LINK=10
# TELEGRAM_API_TIMEOUT_SECONDS=30
# Timetable images have a separate privacy/operations switch because Telegram
# retains and can forward sent media. Keep this false until the disclosure and
# image smoke tests pass. In production leave the internal URL empty: the durable
# worker starts its own short-lived card-only loopback renderer. Never put the
# public web origin here.
TELEGRAM_SEND_TIMETABLE_IMAGES=false
# Graduation maps expose a broader academic-progress snapshot than a weekly
# timetable and therefore require their own explicit opt-in.
TELEGRAM_SEND_GRADUATION_IMAGES=false
# Optional local-development plain-HTTP IPv4-loopback override only
# (127.0.0.1 or localhost; IPv6 ::1 and non-root URLs are rejected).
TELEGRAM_INTERNAL_BASE_URL=
# Debugging only: drain the durable queue job inside the webhook request. Telegram
# redelivers anything it does not get a prompt 200 for, so leave this false in
# production and run telegram_advisor_worker. Pytest always drains inline.
# TELEGRAM_DISPATCH_SYNC=false

# Student OTP email (Twilio SendGrid). Keep disabled for local work. In
# production, verify the From address, store the key outside source control,
# and explicitly enable delivery.
STUDENT_OTP_SENDGRID_ENABLED=false
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=بوابة الطالب
SENDGRID_TIMEOUT_SECONDS=3
# One durable budget shared by student OTP, WhatsApp linking, and manual tests.
# Essentials 50K launch cap: three requests per 1,527 students, plus a small
# operational reserve. Monitor monthly usage before raising it.
SENDGRID_MAX_SUBMISSIONS=4700
SENDGRID_SUBMISSION_WINDOW_SECONDS=86400
# The Verify screen enables Resend after this many seconds.
STUDENT_OTP_RESEND_DELAY_SECONDS=50
# Keep the provider transition inside the request, then hold registered and
# unregistered ID responses to the same minimum duration.
STUDENT_OTP_ASYNC_EMAIL=false
STUDENT_OTP_RESPONSE_FLOOR_SECONDS=3.5

# ── LLM backend ──────────────────────────────────────────────────
# Which endpoint the virtual adviser speaks to. Returning to the local server is
# this one line and a restart — no code change, no branch change.
#   local   = the LOCAL_LLM_* server above (LM Studio &c.)
#   alibaba = Alibaba Cloud Model Studio, OpenAI-compatible endpoint
# An unknown value refuses to start rather than guessing.
LLM_BACKEND=local

# Local OpenAI-compatible endpoint. Remote hosts are refused by the production
# client; keep this loopback and run the model beside the Django process.
LOCAL_LLM_BASE_URL=http://localhost:1234/v1
# Empty permits the local backend's explicit model-discovery flow.
LOCAL_LLM_MODEL=
LOCAL_LLM_TIMEOUT_SECONDS=120
LOCAL_LLM_MAX_TOKENS=1400
LOCAL_LLM_ALLOW_REMOTE=false

# Alibaba Cloud Model Studio. All three of URL, key and model are REQUIRED before
# LLM_BACKEND=alibaba will start; the model is never discovered from the
# workspace, because a silent choice of model is a silent choice of price.
#
# Base URL — the WORKSPACE endpoint from your own Model Studio console. The
# validator accepts only this exact shape, so the public DashScope hosts this
# file used to recommend will not start:
#   https://<workspace>.ap-southeast-1.maas.aliyuncs.com/compatible-mode/v1
# https only, no port, no query, no userinfo, and only the compatible-mode path.
ALIBABA_LLM_BASE_URL=

# NEVER put a real key in this file. THIS FILE IS TRACKED IN GIT — it is
# `.env.example`, not `.env`. Copy it to an untracked `.env`, or set the key in
# the deployment secret manager, and leave this line empty.
ALIBABA_LLM_API_KEY=

# Exact model id as the console shows it, e.g. qwen3.7-plus. If the workspace and
# region do not expose the model you want, stop — nothing here substitutes one.
ALIBABA_LLM_MODEL=

# Non-thinking for the first provider comparison: the local model has already
# spent whole tool turns on hidden reasoning, and changing reasoning mode at the
# same time as the provider measures neither.
ALIBABA_LLM_ENABLE_THINKING=false
ALIBABA_LLM_TIMEOUT_SECONDS=75
ALIBABA_LLM_MAX_TOKENS=3000
ALIBABA_LLM_MAX_RETRIES=2

# THE EGRESS KILL SWITCH. The transport refuses every outbound Alibaba request
# unless this is explicitly true — whatever LLM_BACKEND says, and whichever code
# path built the client. Keep it false except during an explicitly approved live
# operation, and set it back afterwards.
ALIBABA_LLM_ALLOW_LIVE_REQUESTS=false

# V1 adviser loop controls. These affect both runtime duration and the Telegram
# worker's minimum safe lease, so production services must share the same values.
VIRTUAL_ADVISOR_AGENT_LOOP_ENABLED=true
VIRTUAL_ADVISOR_MAX_TOOL_ITERATIONS=5
VIRTUAL_ADVISOR_MAX_TOOL_CALLS=12
VIRTUAL_ADVISOR_LOOP_MAX_TOKENS=3000
VIRTUAL_ADVISOR_TOOL_TURN_TIMEOUT_SECONDS=75

# The evaluation JUDGE stays local on purpose. Judging Alibaba-generated answers
# with Alibaba is a provider marking its own homework.
EVAL_JUDGE_LLM_BACKEND=local

# Student Advisor V2 is one read-only academic agent. It can prepare and explain
# course proposals, but it cannot register courses, save/apply a timetable, or
# change the university portal. Keep off until the V2 evaluation is accepted.
STUDENT_ADVISOR_V2_ENABLED=false
# V2.1 requires V2=true so disabling only V2.1 has a defined V2 rollback target.
STUDENT_ADVISOR_V21_ENABLED=false
STUDENT_ADVISOR_V21_PLAN_MAX_TOKENS=900
STUDENT_ADVISOR_V21_PLAN_TIMEOUT_SECONDS=45
# Local-only superuser launcher for the real student V2.1 page. Never enable in production.
ALLOW_DEV_STUDENT_ADVISOR_LAB=false
STUDENT_ADVISOR_V2_MAX_TOOL_ITERATIONS=4
STUDENT_ADVISOR_V2_MAX_TOOL_CALLS=8
STUDENT_ADVISOR_V2_MAX_TOKENS=1800
STUDENT_ADVISOR_V2_TOOL_TIMEOUT_SECONDS=75
